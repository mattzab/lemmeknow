{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"isolatedModules": true,
		"types": ["@cloudflare/workers-types"],
		"paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/client/*"] }
	},
	"include": ["src", "cloudflare.config.ts", "config-env.d.ts", "vite.config.ts"]
}
